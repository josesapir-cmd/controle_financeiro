# Credenciais da aplicacao Pluggy (painel: https://dashboard.pluggy.ai)
# NUNCA commite o arquivo .env.local com os valores reais.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Base da API. So altere se a Pluggy indicar outro host.
PLUGGY_API_URL=https://api.pluggy.ai

# Conexoes a acompanhar, separadas por virgula. O itemId aparece na URL da
# conexao no dashboard do Meu Pluggy: meu.pluggy.ai/connections/<itemId>
# A API nao expoe rota de listagem, por isso os ids ficam aqui.
PLUGGY_ITEM_IDS=

# Limite de tempo, em milissegundos, para cada chamada a Pluggy.
PLUGGY_TIMEOUT_MS=15000

# Modo offline: usa dados ficticios, sem chamar a Pluggy.
# Util para desenvolver a interface sem gastar chamadas nem expor dados reais.
PLUGGY_MOCK=false

# --- Nuvem ---

# Postgres (Neon). Regiao Sao Paulo. Inclui ?sslmode=require.
DATABASE_URL=

# Chave de criptografia dos campos identificadores, 32 bytes em base64.
# Gere com: openssl rand -base64 32
# Perder esta chave torna descricoes e contrapartes ja gravadas ilegiveis.
APP_ENCRYPTION_KEY=

# Dominio publico do app, usado pelo WebAuthn. Sem protocolo.
# Local: localhost
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost:3210

# Segredo que autoriza o job de sincronizacao a rodar.
# Gere com: openssl rand -hex 32
SYNC_SECRET=

# Segredo do cron da Vercel. So em producao: a plataforma o envia sozinha nas
# chamadas agendadas, no cabecalho Authorization.
CRON_SECRET=

# Chave da API da Anthropic (console.anthropic.com), usada para ler os prints
# do saldo compartilhado do Nubank. Sem ela, o resto do app funciona normalmente
# e apenas o envio de prints responde erro.
ANTHROPIC_API_KEY=

# Fuso usado para resolver o dia de cada lancamento. Trocar isso muda a que dia
# uma transacao pertence, entao so mexa em mudanca de pais.
APP_TIMEZONE=America/Sao_Paulo
