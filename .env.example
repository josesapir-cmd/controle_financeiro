# Credenciais da aplicacao Pluggy (painel: https://dashboard.pluggy.ai)
# NUNCA commite o arquivo .env.local com os valores reais.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Base da API. So altere se a Pluggy indicar outro host.
PLUGGY_API_URL=https://api.pluggy.ai

# Conexoes a acompanhar, separadas por virgula. O itemId aparece na URL da
# conexao no dashboard do Meu Pluggy: meu.pluggy.ai/connections/<itemId>
# A API nao expoe rota de listagem, por isso os ids ficam aqui.
PLUGGY_ITEM_IDS=

# Modo offline: usa dados ficticios, sem chamar a Pluggy.
# Util para desenvolver a interface sem gastar chamadas nem expor dados reais.
PLUGGY_MOCK=false
